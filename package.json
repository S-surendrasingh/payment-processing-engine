{
  "name": "payment-processing-engine",
  "version": "1.0.0",
  "description": "Durable simulated payment processing with PostgreSQL concurrency controls",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/src/server.js",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:seed": "prisma db seed",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:db:prepare": "tsx scripts/prepare-test-db.ts",
    "webhook:send": "tsx scripts/send-webhook.ts",
    "webhook:retry": "tsx scripts/retry-webhook.ts",
    "typecheck": "tsc -p tsconfig.check.json",
    "env:init": "node scripts/init-env.mjs",
    "db:roles": "tsx scripts/configure-runtime-role.ts",
    "format": "prettier --write \"src/**/*.ts\" \"scripts/*.{ts,mjs}\" \"prisma/*.ts\" \"*.{ts,json,yml,md}\" \".github/**/*.yml\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"scripts/*.{ts,mjs}\" \"prisma/*.ts\" \"*.{ts,json,yml,md}\" \".github/**/*.yml\""
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "type": "module",
  "dependencies": {
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "dotenv": "18.0.9",
    "express": "5.3.0",
    "helmet": "8.3.0",
    "pg": "8.23.1",
    "pino": "10.4.0",
    "pino-http": "11.0.0",
    "swagger-ui-express": "5.0.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/express": "5.0.6",
    "@types/node": "26.6.6",
    "@types/pg": "8.23.1",
    "@types/supertest": "7.2.1",
    "@types/swagger-ui-express": "4.1.8",
    "prettier": "3.9.10",
    "prisma": "7.10.1",
    "supertest": "7.3.1",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vitest": "5.1.0"
  },
  "private": true,
  "engines": {
    "node": ">=24.11.0 <25"
  }
}
